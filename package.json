{
  "name": "@lxagents-skills/shared-instruction",
  "version": "6.0.4",
  "description": "Read-only MCP server that delivers the LXAgents shared agent instruction set — branch strategy, commit conventions, rules, creators — plus a registry of the sibling instruction and security servers.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "lxagents-shared-instruction": "dist/index.js"
  },
  "files": [
    "dist",
    "content",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.test.json",
    "start": "node dist/index.js",
    "start:stdio": "node dist/index.js",
    "start:http": "node dist/http.js",
    "pretest": "npm run build && npm run typecheck",
    "test": "node --import tsx --test test/*.test.ts",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "LXAgents",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LXAgents-Skills/shared-instruction.git"
  },
  "homepage": "https://github.com/LXAgents-Skills/shared-instruction#readme",
  "bugs": {
    "url": "https://github.com/LXAgents-Skills/shared-instruction/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agents",
    "agent-instructions",
    "lxagents",
    "connector",
    "sse",
    "http"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
